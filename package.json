{
  "name": "pyschool",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "generate:python-runner": "node scripts/build-python-runner.mjs",
    "predev": "pnpm generate:python-runner",
