---
import type { StationNavigation } from "@/data/stations/navigation";

import Navigation from "./Navigation.astro";

interface Props {
  currentPath: string;
  navigation: StationNavigation;
}

const { currentPath, navigation } = Astro.props;
---

<aside class="border-ink/10 hidden border-r lg:block">
  <div class="sticky top-0 h-dvh px-6 py-10">
    <Navigation currentPath={currentPath} navigation={navigation} />
  </div>
</aside>

<details
  class="border-ink bg-paper mb-10 border-2 shadow-[3px_3px_0_0_#101d27] lg:hidden"
>
  <summary
    class="text-ink cursor-pointer px-4 py-3 font-mono text-xs font-bold tracking-widest"
  >
    VER RECORRIDO
  </summary>

  <div class="border-ink border-t-2 p-5">
    <Navigation currentPath={currentPath} navigation={navigation} />
  </div>
</details>
