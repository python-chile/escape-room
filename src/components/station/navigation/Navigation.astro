---
import type {
  StationNavigation,
  StationNavigationItem,
} from "@/data/stations/navigation";

import { withBase } from "@/lib/paths";

interface Props {
  currentPath: string;
  navigation: StationNavigation;
}

const { currentPath, navigation } = Astro.props;

const links = navigation.items;
const currentIndex = links.findIndex((item) => item.href === currentPath);
const rooms = links.filter((item) => item.type === "room");
const totalRooms = rooms.length;

function getItemMarker(item: StationNavigationItem) {
  if (item.type === "welcome") {
    return "→";
  }

  if (item.type === "final") {
    return "✦";
  }

  return item.label.match(/\d{2}/)?.[0] ?? "•";
}
---

<nav
  aria-label={`Recorrido de ${navigation.title}`}
  class="flex flex-col lg:h-full lg:min-h-0"
  data-station-navigation
>
  <header class="relative pb-8">
    <span
      aria-hidden="true"
      class="font-sketch text-brand/10 absolute top-2 right-2 text-8xl leading-none"
    >
      ✦
    </span>

    <span
      class="bg-accent text-ink shadow-action relative inline-block -rotate-2 px-3 py-1.5 font-mono text-xs font-bold tracking-widest"
    >
      {navigation.code}
    </span>

    <h2
      class="station-title font-sketch text-ink relative mt-5 max-w-52 text-4xl font-bold"
    >
      {navigation.title}
    </h2>

    <div class="relative mt-6">
      <div class="flex items-center justify-between gap-4">
        <p class="text-muted font-mono text-xs font-semibold">progreso local</p>

        <p class="text-ink font-mono text-xs font-bold">
          <span data-station-completed-count>0</span>
          /
          {totalRooms}
        </p>
      </div>

      <div
        role="progressbar"
        aria-label={`Progreso de ${navigation.title}`}
        aria-valuemin="0"
        aria-valuemax={totalRooms}
        aria-valuenow="0"
        class="bg-ink/10 mt-2 h-1.5 overflow-hidden rounded-full"
        data-station-progress
      >
        <div
          class="station-progress-bar bg-brand h-full rounded-full"
          style="width: 0%"
          data-station-progress-bar
        >
        </div>
      </div>
    </div>
  </header>

  <div
    class="station-route border-ink/10 relative border-t pt-6 lg:min-h-0 lg:flex-1 lg:overflow-y-auto lg:pb-10"
  >
    <p class="text-muted px-1 font-mono text-xs font-bold tracking-widest">
      RECORRIDO
    </p>

    <ol class="mt-4">
      {
        links.map((item, index) => {
          const isCurrent = item.href === currentPath;
          const isFinal = item.type === "final";
          const isLast = index === links.length - 1;
          const isRoom = item.type === "room";
          const marker = getItemMarker(item);

          return (
            <li class="relative pl-11">
              {!isLast && (
                <span
                  aria-hidden="true"
                  class:list={[
                    "station-route-line absolute top-9 left-4 border-l border-dashed",
                    index < currentIndex ? "border-brand/35" : "border-ink/15",
                  ]}
                />
              )}

              <a
                href={withBase(item.href)}
                title={item.label}
                aria-current={isCurrent ? "page" : undefined}
                data-station-link
                data-station-path={item.href}
                data-station-room={isRoom ? "true" : undefined}
                class:list={[
                  "station-link group focus-visible:outline-brand relative mb-1 flex min-h-10 items-center px-3 py-2 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2",
                  isCurrent ? "text-brand" : "text-muted hover:text-ink",
                ]}
              >
                <span
                  aria-hidden="true"
                  class:list={[
                    "station-marker text-muted absolute -left-11 grid size-9 place-items-center font-mono text-sm font-bold transition-colors",
                    isFinal ? "text-brand" : "group-hover:text-brand",
                  ]}
                >
                  {marker}
                </span>

                <span class="station-link-label relative leading-5">
                  {item.label}
                </span>

                <span
                  hidden
                  aria-label="Habitación completada"
                  class="text-brand ml-2 font-mono text-xs font-bold"
                  data-station-complete
                >
                  ✓
                </span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </div>
</nav>

<script>
  import { getCompletedRooms } from "@/lib/progress";

  function updateNavigation(navigation: HTMLElement) {
    const completedRooms = getCompletedRooms();

    const roomLinks = Array.from(
      navigation.querySelectorAll<HTMLAnchorElement>(
        '[data-station-room="true"]',
      ),
    );

    const completedCount = roomLinks.filter((link) =>
      completedRooms.has(link.dataset.stationPath ?? ""),
    ).length;

    navigation
      .querySelectorAll<HTMLElement>("[data-station-completed-count]")
      .forEach((count) => {
        count.textContent = String(completedCount);
      });

    navigation
      .querySelectorAll<HTMLElement>("[data-station-progress]")
      .forEach((progress) => {
        progress.setAttribute("aria-valuenow", String(completedCount));
      });

    navigation
      .querySelectorAll<HTMLElement>("[data-station-progress-bar]")
      .forEach((bar) => {
        const percentage =
          roomLinks.length === 0
            ? 0
            : (completedCount / roomLinks.length) * 100;

        bar.style.width = `${percentage}%`;
      });

    navigation
      .querySelectorAll<HTMLAnchorElement>("[data-station-link]")
      .forEach((link) => {
        const path = link.dataset.stationPath ?? "";
        const isCompleted = completedRooms.has(path);

        link.dataset.completed = String(isCompleted);

        const completedMark = link.querySelector<HTMLElement>(
          "[data-station-complete]",
        );

        if (completedMark) {
          completedMark.hidden = !isCompleted;
        }
      });
  }

  function updateAllNavigations() {
    document
      .querySelectorAll<HTMLElement>("[data-station-navigation]")
      .forEach(updateNavigation);
  }

  updateAllNavigations();

  window.addEventListener("pyschool-progress-change", updateAllNavigations);

  window.addEventListener("storage", updateAllNavigations);
</script>

<style>
  .station-title {
    line-height: 0.85;
  }

  .station-progress-bar {
    transition: width 500ms ease;
  }

  .station-route-line {
    height: calc(100% - 0.5rem);
  }

  .station-link[aria-current="page"] .station-link-label::after {
    position: absolute;
    right: 0;
    bottom: -0.25rem;
    left: 0;
    height: 0.25rem;
    background: var(--color-accent);
    content: "";
    transform: rotate(-1deg);
  }

  .station-link[data-completed="true"]:not([aria-current="page"]) {
    color: color-mix(in srgb, var(--color-brand) 70%, var(--color-ink));
  }

  .station-link[data-completed="true"] .station-marker {
    color: var(--color-brand);
  }

  @media (min-width: 64rem) {
    .station-route {
      padding-right: 0.5rem;
      scrollbar-color: color-mix(in srgb, var(--color-ink) 30%, transparent)
        transparent;
      scrollbar-width: thin;
    }

    .station-route::-webkit-scrollbar {
      width: 5px;
    }

    .station-route::-webkit-scrollbar-track {
      background: transparent;
    }

    .station-route::-webkit-scrollbar-thumb {
      background: color-mix(in srgb, var(--color-ink) 30%, transparent);
      border-radius: 999px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .station-progress-bar {
      transition: none;
    }
  }
</style>
