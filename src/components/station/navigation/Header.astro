---
import GitHubAuth from "@/components/auth/GitHubAuth.astro";
import PythonChileBrand from "@/components/ui/PythonChileBrand.astro";
import { getStationById } from "@/data/stations/registry";

import ExitMissionLink from "./header/ExitMissionLink.astro";
import MissionSwitcher from "./header/MissionSwitcher.astro";

interface Props {
  stationId: string;
}

const { stationId } = Astro.props;

const currentStation = getStationById(stationId);

if (!currentStation) {
  throw new Error(
    `No existe una estación registrada con el ID "${stationId}".`,
  );
}
---

<header class="relative z-30">
  <nav
    aria-label="Navegación de la estación"
    class="flex min-h-16 w-full items-center justify-between gap-2 py-3 sm:min-h-20 sm:gap-4 sm:py-4"
  >
    <div class="flex min-w-0 items-center gap-2 sm:gap-6">
      <PythonChileBrand size="compact" />

      <span aria-hidden="true" class="bg-ink/10 hidden h-8 w-px sm:block"
      ></span>

      <ExitMissionLink />
    </div>

    <div class="flex shrink-0 items-center gap-1 sm:gap-4">
      <MissionSwitcher
        stationId={currentStation.id}
        currentTitle={currentStation.title}
      />

      <span aria-hidden="true" class="bg-ink/10 hidden h-8 w-px sm:block"
      ></span>

      <GitHubAuth />
    </div>
  </nav>
</header>
