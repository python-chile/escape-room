---
import { withBase } from "@/lib/paths";

const stationsUrl = withBase("/#estaciones");
---

<a
  href={stationsUrl}
  aria-label="Salir de la misión y volver al listado de estaciones"
  title="Salir de la misión"
  class="text-muted hover:bg-brand/5 hover:text-brand focus-visible:outline-brand inline-flex size-11 shrink-0 items-center justify-center rounded-lg transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 sm:w-auto sm:gap-2 sm:px-3"
>
  <svg aria-hidden="true" viewBox="0 0 20 20" class="size-5 sm:size-4">
    <path
      d="M16 10H4m5-5-5 5 5 5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>

  <span class="hidden text-sm font-semibold sm:inline">
    Salir de la misión
  </span>
</a>
