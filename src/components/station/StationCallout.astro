---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<aside class="mt-8 border-l-4 border-brand bg-brand/5 px-5 py-4">
  <p class="font-mono text-xs font-bold tracking-widest text-brand">
    {title}
  </p>

  <div class="mt-2 text-base leading-7 text-muted">
    <slot />
  </div>
</aside>
