---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<aside
  class="border-brand bg-brand/5 mt-8 border-l-4 px-5 py-4"
  aria-label={title}
>
  <p class="text-brand font-mono text-xs font-bold tracking-widest">
    {title}
  </p>

  <div class="text-muted mt-2 text-base leading-7">
    <slot />
  </div>
</aside>
