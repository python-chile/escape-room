<div class="grid min-h-96 lg:h-128 lg:min-h-0" data-python-workspace>
  <div class="min-h-80 min-w-0 lg:h-full lg:min-h-0" data-python-code-panel>
    <div class="h-full overflow-hidden bg-white" data-python-code></div>
  </div>

  <section
    hidden
    class="border-line-soft bg-panel min-h-80 min-w-0 flex-col border-t lg:h-full lg:min-h-0 lg:border-t-0 lg:border-l"
    aria-label="Resultado de la ejecución"
    data-python-results
  >
    <header
      class="border-line-soft flex items-center gap-2 border-b bg-white px-5 py-3.5"
    >
      <span class="text-brand font-mono text-sm font-bold" aria-hidden="true">
        &gt;_
      </span>

      <span class="text-ink font-mono text-xs font-bold tracking-widest">
        SALIDA
      </span>
    </header>

    <div class="text-muted px-5 py-3 font-mono text-xs">$ python main.py</div>

    <pre
      class="border-line-soft bg-panel text-ink min-h-0 flex-1 overflow-auto border-t p-5 font-mono text-sm leading-7"
      aria-live="polite"
      data-python-output>
    </pre>
  </section>
</div>

<style>
  @media (min-width: 64rem) {
    .python-workspace--with-results {
      grid-template-columns:
        minmax(0, 1.2fr)
        minmax(17rem, 0.8fr);
    }
  }
</style>
