---
interface Props {
  editorId: string;
}

const { editorId } = Astro.props;

const chartTabId = `${editorId}-chart-tab`;
const chartPanelId = `${editorId}-chart-panel`;

const chartDialogId = `${editorId}-chart-dialog`;
const chartDialogTitleId = `${editorId}-chart-dialog-title`;
---

<section
  id={chartPanelId}
  hidden
  role="tabpanel"
  tabindex="0"
  aria-labelledby={chartTabId}
  class="bg-panel min-h-56 p-5"
  data-python-terminal-panel="chart"
  data-python-chart-container
>
  <header class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-2">
      <span class="text-brand font-mono text-sm font-bold" aria-hidden="true">
        ✦
      </span>

      <span class="text-brand font-mono text-xs font-bold tracking-widest">
        GRÁFICO GENERADO
      </span>
    </div>

    <div class="flex items-center gap-1">
      <button
        type="button"
        class="text-brand hover:bg-brand/10 focus-visible:outline-brand inline-flex min-h-10 items-center gap-2 px-3 text-sm font-bold transition-colors focus-visible:outline-2"
        aria-controls={chartDialogId}
        data-python-chart-expand
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 20 20"
          class="size-4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M7 3H3v4"></path>
          <path d="m3 3 5 5"></path>
          <path d="M13 17h4v-4"></path>
          <path d="m17 17-5-5"></path>
        </svg>

        Ampliar
      </button>

      <button
        type="button"
        class="text-brand hover:bg-brand/10 focus-visible:outline-brand inline-flex min-h-10 items-center gap-2 px-3 text-sm font-bold transition-colors focus-visible:outline-2"
        data-python-chart-download
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 20 20"
          class="size-4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M10 3v9"></path>
          <path d="m6.5 8.5 3.5 3.5 3.5-3.5"></path>
          <path d="M4 16h12"></path>
        </svg>

        Descargar PNG
      </button>
    </div>
  </header>

  <div
    class="border-line flex min-h-80 items-center justify-center overflow-hidden border bg-white p-3"
  >
    <img
      alt="Gráfico generado por Python"
      class="max-h-screen w-full bg-white object-contain"
      data-python-chart
    />
  </div>
</section>

<dialog
  id={chartDialogId}
  class="backdrop:bg-ink/55 m-auto w-full max-w-5xl border-0 bg-transparent p-5"
  aria-labelledby={chartDialogTitleId}
  data-python-chart-dialog
>
  <div class="border-line bg-paper border p-4 shadow-xl">
    <header class="mb-4 flex items-center justify-between gap-4">
      <span
        id={chartDialogTitleId}
        class="text-ink font-mono text-sm font-bold"
      >
        Gráfico generado
      </span>

      <button
        type="button"
        class="text-muted hover:bg-ink/5 hover:text-ink focus-visible:outline-brand grid size-10 place-items-center transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
        aria-label="Cerrar gráfico"
        data-python-chart-dialog-close
      >
        ✕
      </button>
    </header>

    <img
      alt="Vista ampliada del gráfico generado por Python"
      class="max-h-screen w-full bg-white object-contain"
      data-python-chart-dialog-image
    />
  </div>
</dialog>
