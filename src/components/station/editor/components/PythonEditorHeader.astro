---
interface Props {
  editorId: string;
}

const { editorId } = Astro.props;
---

<header
  class="border-line-soft bg-panel flex min-h-14 items-center justify-between gap-4 border-b px-4 sm:px-5"
>
  <div class="flex min-w-0 items-center gap-3">
    <span
      class="text-brand shrink-0 font-mono text-base font-bold"
      aria-hidden="true"
    >
      &lt;/&gt;
    </span>

    <span class="text-ink truncate font-mono text-sm font-bold"> main.py </span>
  </div>

  <div class="flex shrink-0 items-center gap-2">
    <div
      class="text-muted hidden items-center gap-2 font-mono text-xs font-semibold sm:flex"
      role="status"
      aria-live="polite"
    >
      <span
        class="bg-brand size-1.5 rounded-full"
        aria-hidden="true"
        data-python-status-dot></span>

      <span data-python-status-text> Preparando entorno… </span>
    </div>

    <span class="bg-ink/10 mx-1 hidden h-7 w-px sm:block" aria-hidden="true"
    ></span>

    <button
      type="button"
      class="text-muted hover:bg-brand/10 hover:text-brand focus-visible:outline-brand grid size-10 place-items-center transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
      aria-label="Ampliar editor"
      aria-controls={editorId}
      aria-expanded="false"
      title="Ampliar editor"
      data-python-editor-expand
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="size-5 transition-transform"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        data-python-editor-expand-icon
      >
        <path d="M8 3H3v5"></path>
        <path d="M16 3h5v5"></path>
        <path d="M8 21H3v-5"></path>
        <path d="M16 21h5v-5"></path>
      </svg>
    </button>
  </div>
</header>
