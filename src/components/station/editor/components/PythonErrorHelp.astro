<aside
  hidden
  class="border-line border-l-python-red absolute top-20 right-5 left-5 z-30 border border-l-4 bg-white p-4 shadow-lg sm:left-auto sm:w-96"
  role="alert"
  aria-live="polite"
  data-python-error-help
>
  <div class="flex items-start gap-3">
    <span
      class="bg-python-red/10 text-python-red grid size-8 shrink-0 place-items-center rounded-full font-mono text-sm font-bold"
      aria-hidden="true"
    >
      !
    </span>

    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-3">
        <div>
          <span
            class="text-python-red font-mono text-xs font-bold tracking-widest"
          >
            ERROR DETECTADO
          </span>

          <div class="text-ink mt-1 font-bold" data-python-error-help-name>
          </div>
        </div>

        <button
          type="button"
          class="text-muted hover:bg-ink/5 hover:text-ink grid size-8 shrink-0 place-items-center transition-colors"
          aria-label="Cerrar explicación"
          data-python-error-help-close
        >
          ✕
        </button>
      </div>

      <div
        class="text-muted mt-2 text-sm leading-6"
        data-python-error-help-explanation
      >
      </div>

      <div class="mt-3 flex items-start gap-2 text-sm leading-6">
        <span class="text-brand shrink-0 font-bold" aria-hidden="true">
          →
        </span>

        <div>
          <span class="text-ink font-bold"> Sugerencia: </span>

          <span class="text-muted" data-python-error-help-suggestion></span>
        </div>
      </div>
    </div>
  </div>
</aside>
