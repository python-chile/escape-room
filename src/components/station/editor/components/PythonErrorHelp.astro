<aside
  hidden
  class="border-line-soft bg-panel border-l-brand mt-3 border-l-4 px-4 py-3"
  role="note"
  aria-live="polite"
  data-python-error-help
>
  <div class="flex items-start gap-3">
    <span
      class="bg-brand/10 text-brand grid size-7 shrink-0 place-items-center rounded-full font-mono text-xs font-bold"
      aria-hidden="true"
    >
      ?
    </span>

    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
        <span class="text-brand font-mono text-xs font-bold tracking-widest">
          AYUDA
        </span>

        <span aria-hidden="true" class="text-muted"> · </span>

        <span class="text-ink text-sm font-bold" data-python-error-help-name>
        </span>
      </div>

      <div
        class="text-muted mt-1 text-sm leading-6"
        data-python-error-help-explanation
      >
      </div>

      <div class="mt-2 flex items-start gap-2 text-sm leading-6">
        <span class="text-ink shrink-0 font-bold" aria-hidden="true"> → </span>

        <div>
          <span class="text-ink font-bold"> Sugerencia: </span>

          <span class="text-muted" data-python-error-help-suggestion> </span>
        </div>
      </div>
    </div>
  </div>
</aside>
