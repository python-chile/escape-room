---
import { withBase } from "@/lib/paths";

import type { Challenge } from "./types";

interface Props {
  starterCode: string;
  challenge?: Challenge;
}

const { starterCode, challenge } = Astro.props;

const resolvedChallenge = challenge
  ? {
      ...challenge,
      successHref: challenge.successHref
        ? withBase(challenge.successHref)
        : undefined,
      dataset: challenge.dataset
        ? {
            ...challenge.dataset,
            source: withBase(challenge.dataset.source),
          }
        : undefined,
    }
  : undefined;
---

<div
  class="mt-10"
  data-python-editor
  data-python-starter-code={starterCode}
  data-python-challenge={resolvedChallenge
    ? JSON.stringify(resolvedChallenge)
    : undefined}
>
  <div class="border-line shadow-editor overflow-hidden border bg-white">
    <header
      class="border-line-soft bg-panel flex items-center justify-between gap-4 border-b px-5 py-3.5"
    >
      <div class="flex items-center gap-3">
        <span class="text-brand font-mono text-base font-bold">
          &lt;/&gt;
        </span>

        <span class="text-ink font-mono text-sm font-bold"> main.py </span>
      </div>

      <div
        class="text-muted flex items-center gap-2 font-mono text-xs font-semibold"
        role="status"
        aria-live="polite"
      >
        <span class="bg-brand size-1.5 rounded-full" aria-hidden="true"> </span>

        <span data-python-status-text> Preparando entorno… </span>
      </div>
    </header>

    <div class="grid min-h-96 lg:h-128 lg:min-h-0" data-python-workspace>
      <div class="min-h-80 min-w-0 lg:h-full lg:min-h-0" data-python-code-panel>
        <div class="h-full overflow-hidden bg-white" data-python-code></div>
      </div>

      <section
        hidden
        class="border-line-soft bg-panel min-h-80 min-w-0 flex-col border-t lg:h-full lg:min-h-0 lg:border-t-0 lg:border-l"
        aria-label="Resultado de la ejecución"
        data-python-results
      >
        <header
          class="border-line-soft flex items-center gap-2 border-b bg-white px-5 py-3.5"
        >
          <span
            class="text-brand font-mono text-sm font-bold"
            aria-hidden="true"
          >
            &gt;_
          </span>

          <span class="text-ink font-mono text-xs font-bold tracking-widest">
            SALIDA
          </span>
        </header>

        <div class="text-muted px-5 py-3 font-mono text-xs">
          $ python main.py
        </div>

        <pre
          class="border-line-soft bg-panel text-ink min-h-0 flex-1 overflow-auto border-t p-5 font-mono text-sm leading-7"
          aria-live="polite"
          data-python-output>
        </pre>
      </section>
    </div>

    <footer
      class="border-line-soft bg-paper flex flex-wrap items-center gap-2 border-t px-4 py-4 sm:px-5"
    >
      <button
        type="button"
        disabled
        class="bg-accent text-ink shadow-action hover:bg-accent-dark focus-visible:outline-brand inline-flex items-center gap-3 px-5 py-3 font-bold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
        data-python-run
      >
        <span aria-hidden="true">▶</span>
        Ejecutar código
      </button>

      <div class="flex items-center gap-1">
        <div data-python-hint-slot></div>

        <button
          type="button"
          class="text-muted hover:bg-ink/5 hover:text-ink focus-visible:outline-brand grid size-10 place-items-center transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
          aria-label="Restablecer código"
          title="Restablecer código"
          data-python-reset
        >
          <svg
            aria-hidden="true"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M3 12a9 9 0 1 0 3-6.7"></path>
            <path d="M3 4v5h5"></path>
          </svg>
        </button>
      </div>

      <label
        class="text-muted hover:bg-ink/5 hover:text-ink flex cursor-pointer items-center gap-2 px-3 py-2 text-sm font-medium transition-colors"
        title="Mostrar explicaciones sencillas para errores comunes de Python"
      >
        <input
          type="checkbox"
          class="accent-brand size-4"
          data-python-error-help-toggle
        />

        <span>Explicar errores</span>
      </label>

      <a
        hidden
        class="text-brand decoration-accent hover:text-brand-dark ml-auto px-2 py-2 font-bold underline decoration-2 underline-offset-4 transition-colors"
        data-python-next
      >
      </a>
    </footer>
  </div>

  <aside
    hidden
    class="border-line-soft bg-panel border-l-brand mt-3 border-l-4 px-4 py-3"
    role="note"
    aria-live="polite"
    data-python-error-help
  >
    <div class="flex items-start gap-3">
      <span
        class="bg-brand/10 text-brand grid size-7 shrink-0 place-items-center rounded-full font-mono text-xs font-bold"
        aria-hidden="true"
      >
        ?
      </span>

      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
          <span class="text-brand font-mono text-xs font-bold tracking-widest">
            AYUDA
          </span>

          <span aria-hidden="true" class="text-muted"> · </span>

          <span class="text-ink text-sm font-bold" data-python-error-help-name>
          </span>
        </div>

        <div
          class="text-muted mt-1 text-sm leading-6"
          data-python-error-help-explanation
        >
        </div>

        <div class="mt-2 flex items-start gap-2 text-sm leading-6">
          <span class="text-ink shrink-0 font-bold" aria-hidden="true">
            →
          </span>

          <div>
            <span class="text-ink font-bold"> Sugerencia: </span>

            <span class="text-muted" data-python-error-help-suggestion> </span>
          </div>
        </div>
      </div>
    </div>
  </aside>

  <p
    hidden
    class="mt-5 border-l-4 px-4 py-3 text-sm font-medium"
    aria-live="polite"
    data-python-feedback
  >
  </p>

  <div hidden class="mt-8" data-python-chart-container>
    <div class="flex items-center gap-2">
      <span class="text-brand font-mono text-sm font-bold" aria-hidden="true">
        ✦
      </span>

      <p class="text-muted font-mono text-xs font-bold tracking-widest">
        GRÁFICO GENERADO
      </p>
    </div>

    <div class="border-line shadow-panel mt-3 overflow-hidden border bg-white">
      <img
        alt="Gráfico generado por Python"
        class="w-full bg-white"
        data-python-chart
      />
    </div>
  </div>

  <iframe
    title="Entorno aislado de ejecución Python"
    src={withBase("/python-runner.html")}
    sandbox="allow-scripts"
    referrerpolicy="no-referrer"
    class="hidden"
    data-python-runner
  >
  </iframe>
</div>

<script>
  import { initializePythonEditors } from "./initialize";

  initializePythonEditors();
</script>

<style>
  @media (min-width: 64rem) {
    .python-workspace--with-results {
      grid-template-columns:
        minmax(0, 1.2fr)
        minmax(17rem, 0.8fr);
    }
  }
</style>
