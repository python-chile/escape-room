---
import GitHubAuth from "@/components/auth/GitHubAuth.astro";
import { stations } from "@/data/stations/registry";
import { withBase } from "@/lib/paths";

interface Props {
  station: string;
}

const { station } = Astro.props;

const homeUrl = withBase("/");
const logoUrl = withBase("/brand/pythonchile.png");
---

<header
  class="border-ink/10 relative flex items-center justify-between gap-4 border-b py-4 sm:py-5"
>
  <div class="flex min-w-0 items-center gap-4 sm:gap-5">
    <a
      href={homeUrl}
      aria-label="Ir al inicio de PySchool"
      class="focus-visible:outline-brand shrink-0 focus-visible:outline-2 focus-visible:outline-offset-4"
    >
      <img
        src={logoUrl}
        alt="Python Chile"
        class="h-8 w-auto object-contain sm:h-10"
      />
    </a>

    <a
      href={homeUrl}
      class="border-ink/15 text-muted hover:text-brand focus-visible:outline-brand hidden items-center gap-2 border-l pl-5 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 sm:inline-flex"
    >
      <span aria-hidden="true" class="font-mono text-base">←</span>
      Volver al inicio
    </a>
  </div>

  <div class="flex shrink-0 items-center gap-2 sm:gap-3">
    <GitHubAuth />

    <details class="group relative">
      <summary
        class="bg-brand hover:bg-brand-dark focus-visible:outline-brand flex cursor-pointer list-none items-center gap-2 rounded-lg px-4 py-3 font-mono text-xs font-bold tracking-widest text-white transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 sm:px-5 [&::-webkit-details-marker]:hidden"
      >
        <span class="hidden sm:inline">CAMBIAR MISIÓN</span>
        <span class="sm:hidden">MISIONES</span>

        <span
          aria-hidden="true"
          class="text-base leading-none transition-transform duration-200 group-open:rotate-45"
        >
          +
        </span>
      </summary>

      <div
        class="border-ink/15 shadow-ink/10 absolute right-0 z-20 mt-3 w-80 rounded-xl border bg-white p-3 shadow-xl"
      >
        <p
          class="text-muted px-2 pt-1 pb-3 font-mono text-[0.7rem] font-bold tracking-widest"
        >
          ELIGE UNA MISIÓN
        </p>

        <ul class="grid gap-2">
          {
            stations.map((item) => {
              const isCurrent = item.name === station;

              return (
                <li>
                  <a
                    href={withBase(item.href)}
                    aria-current={isCurrent ? "page" : undefined}
                    class:list={[
                      "group/item focus-visible:outline-brand flex items-center gap-3 rounded-lg p-2 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2",
                      isCurrent ? "bg-brand/8" : "hover:bg-accent/20",
                    ]}
                  >
                    <img
                      src={withBase(item.image)}
                      alt=""
                      width="112"
                      height="112"
                      class="size-14 shrink-0 object-cover"
                    />

                    <span class="min-w-0 flex-1">
                      <span class="text-muted block font-mono text-[0.7rem] font-bold tracking-widest">
                        {item.code}
                      </span>

                      <span
                        class:list={[
                          "mt-1 block text-sm leading-5 font-bold",
                          isCurrent ? "text-brand" : "text-ink",
                        ]}
                      >
                        {item.title}
                      </span>
                    </span>

                    <span
                      aria-hidden="true"
                      class:list={[
                        "font-mono text-sm",
                        isCurrent
                          ? "text-brand"
                          : "text-muted group-hover/item:text-ink transition-transform group-hover/item:translate-x-0.5",
                      ]}
                    >
                      {isCurrent ? "•" : "→"}
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </details>
  </div>
</header>
