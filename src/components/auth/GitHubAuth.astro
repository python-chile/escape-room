---
import { withBase } from "@/lib/paths";

const accountHref = withBase("/cuenta");
---

<div class="flex items-center" data-github-auth>
  <button
    type="button"
    class="text-ink hover:border-accent focus-visible:outline-brand inline-flex items-center gap-2 border-b-2 border-transparent px-1 py-2 font-mono text-xs font-bold tracking-widest transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
    data-github-login
  >
    <svg
      aria-hidden="true"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="currentColor"
    >
      <path
        d="M12 2C6.48 2 2 6.58 2 12.24c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-1.04-.01-1.89-2.78.62-3.37-1.2-3.37-1.2-.45-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1.01.07 1.54 1.06 1.54 1.06.9 1.58 2.35 1.12 2.92.86.09-.67.35-1.12.64-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.4c.85 0 1.7.12 2.5.35 1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.35 4.8-4.58 5.06.36.32.68.93.68 1.88 0 1.36-.01 2.45-.01 2.79 0 .27.18.59.69.49A10.27 10.27 0 0 0 22 12.24C22 6.58 17.52 2 12 2Z"
      ></path>
    </svg>

    <span>SIGN IN</span>
  </button>

  <a
    hidden
    href={accountHref}
    class="text-ink hover:border-accent focus-visible:outline-brand inline-flex items-center gap-2 border-b-2 border-transparent px-1 py-1.5 font-mono text-xs font-bold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
    data-github-account
  >
    <img
      src=""
      alt=""
      width="28"
      height="28"
      class="border-ink/10 size-7 rounded-full border object-cover"
      data-github-avatar
    />

    <span class="hidden max-w-28 truncate sm:block" data-github-name></span>

    <span class="text-brand" aria-hidden="true">→</span>
  </a>
</div>

<script>
  import { initializeGitHubAuth } from "./initialize-github-auth";

  initializeGitHubAuth();
</script>
