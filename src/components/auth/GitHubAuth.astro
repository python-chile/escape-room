---
import { withBase } from "@/lib/paths";

import GitHubIcon from "./GitHubIcon.astro";

const accountHref = withBase("/cuenta");
---

<div class="flex items-center" data-github-auth>
  <button
    type="button"
    class="github-auth-button group text-ink hover:text-brand focus-visible:outline-brand relative inline-flex items-center gap-3 rounded-lg px-4 py-2.5 font-mono text-xs font-bold tracking-widest transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
    data-github-login
  >
    <svg
      class="sketchbox pointer-events-none absolute inset-0"
      viewBox="0 0 130 44"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path d="M4 6 C 2 20, 3 30, 5 40 L 122 41 C 126 30, 125 15, 124 4 L 6 3 Z"
      ></path>
    </svg>
    <GitHubIcon />
    <span>SIGN IN</span>
  </button>
  <a
    hidden
    href={accountHref}
    class="group focus-visible:outline-brand inline-flex items-center gap-2.5 rounded-md px-1 py-2 focus-visible:outline-2 focus-visible:outline-offset-4"
    data-github-account
  >
    <img
      src=""
      alt=""
      width="32"
      height="32"
      class="border-ink/10 size-8 rounded-full border object-cover transition-transform duration-200 motion-safe:group-hover:scale-105"
      data-github-avatar
    />

    <span class="relative hidden pb-1 sm:block">
      <span
        class="text-ink group-hover:text-brand block max-w-28 truncate text-sm font-bold transition-colors"
        data-github-name></span>

      <span
        aria-hidden="true"
        class="bg-accent absolute right-0 bottom-0 left-0 h-0.5 origin-left scale-x-0 rounded-full transition-transform duration-300 group-hover:scale-x-100"
      ></span>
    </span>
  </a>

  <script>
    import { initializeGitHubAuth } from "./initialize-github-auth";

    initializeGitHubAuth();
  </script>

  <style>
    .sketchbox path {
      fill: none;
      stroke: var(--color-brand);
      stroke-width: 1.6;
      stroke-dasharray: 260;
      stroke-dashoffset: 260;
      transition: stroke-dashoffset 0.55s ease;
    }

    :global(.github-auth-button:hover) .sketchbox path,
    :global(.github-auth-button:focus-visible) .sketchbox path {
      stroke-dashoffset: 0;
    }

    :global(.github-auth-button:hover) :global(.github-icon),
    :global(.github-auth-button:focus-visible) :global(.github-icon) {
      transform: scale(1.08) rotate(4deg);
    }

    @media (prefers-reduced-motion: reduce) {
      .sketchbox path {
        transition: none;
      }
    }
  </style>
</div>
