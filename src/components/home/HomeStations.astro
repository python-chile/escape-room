---
import { stations } from "@/data/stations/registry";

import { withBase } from "@/lib/paths";
---

<section id="estaciones" aria-labelledby="stations-title" class="relative">
  <img
    src={withBase("/decorations/station-snake.png")}
    alt=""
    aria-hidden="true"
    width="320"
    height="480"
    loading="lazy"
    class="pointer-events-none absolute top-12 -left-16 hidden w-32 object-contain select-none lg:block xl:-left-12 xl:w-36"
  />

  <div class="mx-auto max-w-5xl">
    <header class="mx-auto max-w-3xl text-center">
      <h2
        id="stations-title"
        class="font-sketch text-ink mt-4 text-5xl leading-none font-bold tracking-tight sm:text-6xl"
      >
        Elige una <span class="text-brand">misión.</span>
      </h2>

      <p class="text-muted mt-5 text-lg">
        Cada estación es una aventura distinta.
      </p>
    </header>

    <ol class="border-ink/10 mt-12 border-y">
      {
        stations.map((station) => (
          <li class="border-ink/10 border-b last:border-b-0">
            <a
              href={withBase(station.href)}
              class="group hover:bg-brand/4.5 focus-visible:outline-brand flex items-center gap-4 rounded-xl px-3 py-5 transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-4 sm:gap-6 sm:px-4"
            >
              <span class="text-brand group-hover:text-brand-dark w-8 shrink-0 font-mono text-sm font-bold transition-colors">
                {station.code.replace("ESTACIÓN ", "")}
              </span>

              <div class="bg-ink/5 size-16 shrink-0 overflow-hidden sm:size-20">
                <img
                  src={withBase(station.image)}
                  alt=""
                  width="160"
                  height="160"
                  class="size-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </div>

              <h3 class="text-ink group-hover:text-brand min-w-0 flex-1 text-xl font-bold tracking-tight transition-colors sm:text-2xl">
                {station.title}
              </h3>

              <span
                aria-hidden="true"
                class="text-brand shrink-0 -translate-x-2 text-xl opacity-0 transition-all duration-200 group-hover:translate-x-0 group-hover:opacity-100"
              >
                →
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>
