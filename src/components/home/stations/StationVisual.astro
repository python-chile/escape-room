---
import { withBase } from "@/lib/paths";

interface Props {
  number: string;
  title: string;
  href: string;
  image: string;
  reverse: boolean;
}

const { number, title, href, image, reverse } = Astro.props;
---

<div
  class:list={[
    "relative flex items-center justify-end pr-12",
    "max-md:justify-start max-md:p-0",
    reverse && "order-2 justify-start pr-0 pl-12 max-md:order-0 max-md:pl-0",
  ]}
>
  <a
    href={withBase(href)}
    aria-label={`Explorar ${title}`}
    class:list={[
      "group flex items-center gap-6 rounded-xl outline-offset-8",
      "focus-visible:outline-2 focus-visible:outline-(--station-accent)",
      "max-md:gap-4",
      reverse && "flex-row-reverse max-md:flex-row",
    ]}
  >
    <span
      aria-hidden="true"
      class="station-number font-sketch shrink-0 text-8xl leading-none font-bold text-transparent opacity-60 transition-opacity group-hover:opacity-80 max-md:text-6xl max-md:opacity-50"
    >
      {number}
    </span>

    <div
      class="station-image relative size-56 shrink-0 overflow-hidden rounded-full border-4 border-(--station-accent) bg-white max-md:size-40"
    >
      <img
        src={withBase(image)}
        alt=""
        width="448"
        height="448"
        class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    </div>
  </a>
</div>

<style>
  .station-number {
    -webkit-text-stroke: 0.1rem var(--station-accent);
  }

  .station-image {
    box-shadow:
      0 0 0 0.3rem var(--color-paper),
      0 0 0 0.44rem var(--station-accent);
  }

  @media (max-width: 767px) {
    .station-number {
      -webkit-text-stroke-width: 0.075rem;
    }
  }
</style>
