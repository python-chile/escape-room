---
import { withBase } from "@/lib/paths";

import StationList from "./StationList.astro";
import StationsBackdrop from "./StationsBackdrop.astro";
---

<section
  id="estaciones"
  aria-labelledby="stations-title"
  class="bg-paper relative isolate overflow-hidden px-6 pt-24 pb-20 sm:px-10 sm:pt-28 sm:pb-28"
>
  <StationsBackdrop />

  <img
    src={withBase("/decorations/station-snake.png")}
    alt=""
    aria-hidden="true"
    width="320"
    height="480"
    loading="lazy"
    class="pointer-events-none absolute top-24 -left-4 z-20 hidden w-36 object-contain select-none lg:block xl:left-0 xl:w-44"
  />

  <div class="relative z-10 mx-auto max-w-5xl">
    <header class="mx-auto max-w-3xl text-center">
      <h2
        id="stations-title"
        class="font-sketch text-ink text-5xl leading-none font-bold tracking-tight sm:text-6xl"
      >
        Elige una <span class="text-brand">misión.</span>
      </h2>

      <p class="text-muted mt-5 text-lg">
        Cada estación es una aventura distinta.
      </p>
    </header>

    <StationList />
  </div>
</section>
