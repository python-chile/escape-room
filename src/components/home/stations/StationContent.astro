---
import { withBase } from "@/lib/paths";

interface Props {
  title: string;
  href: string;
  objectiveLead: string;
  objectiveRest: string;
  reverse?: boolean;
}

const {
  title,
  href,
  objectiveLead,
  objectiveRest,
  reverse = false,
} = Astro.props;
---

<a
  href={withBase(href)}
  class:list={[
    "group block w-full rounded-xl px-0 pt-6",
    "focus-visible:outline-2 focus-visible:outline-offset-4",
    "focus-visible:outline-(--station-accent)",
    "md:py-4",
    reverse
      ? "md:order-1 md:justify-self-end md:pr-8 md:text-right"
      : "md:pl-8",
  ]}
>
  <h3
    class:list={[
      "text-ink max-w-md text-3xl leading-tight font-bold tracking-tight transition-colors",
      "group-hover:text-(--station-accent)",
      "sm:text-4xl",
      reverse && "md:ml-auto",
    ]}
  >
    {title}
  </h3>

  <p
    class:list={[
      "text-ink mt-4 max-w-md text-xl leading-snug sm:text-2xl",
      reverse && "md:ml-auto",
    ]}
  >
    <span class="objective-action font-bold text-(--station-accent)">
      {objectiveLead}
    </span>{" "}
    {objectiveRest}

    <span
      aria-hidden="true"
      class="ml-2 inline-block font-mono font-bold text-(--station-accent)"
    >
      →
    </span>
  </p>
</a>

<style>
  .objective-action {
    position: relative;
    display: inline-block;
  }

  .objective-action::after {
    position: absolute;
    right: -0.08rem;
    bottom: 0.02rem;
    left: -0.08rem;
    height: 0.16rem;
    border-radius: 9999px 70% 9999px 65%;
    background-color: var(--station-accent);
    content: "";
    opacity: 0.9;
    transform: rotate(-1.5deg) skewX(-8deg);
    transform-origin: left center;
  }
</style>
