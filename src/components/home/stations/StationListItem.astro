---
import StationContent from "./StationContent.astro";
import StationVisual from "./StationVisual.astro";

interface Props {
  code: string;
  title: string;
  href: string;
  image: string;
  objectiveLead: string;
  objectiveRest: string;
  accent: string;
  reverse: boolean;
}

const {
  code,
  title,
  href,
  image,
  objectiveLead,
  objectiveRest,
  accent,
  reverse,
} = Astro.props;

const stationNumber = code.replace("ESTACIÓN ", "");
---

<li
  class="relative grid min-h-72 grid-cols-2 items-center max-md:block max-md:min-h-0"
  style={`--station-accent: ${accent}`}
>
  <StationVisual
    number={stationNumber}
    title={title}
    href={href}
    image={image}
    reverse={reverse}
  />

  <StationContent
    title={title}
    href={href}
    objectiveLead={objectiveLead}
    objectiveRest={objectiveRest}
    reverse={reverse}
  />
</li>
