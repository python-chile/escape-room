---
const dataCode = `datos = [1, 2, 3]
for d in datos:
    print(d)`;

const loopCode = `for dato in lista:
    print(dato)`;

const conditionCode = `x = 10
if x > 5:
    print("mayor")`;

const functionCode = `def sumar(a, b):
    return a + b`;
---

<div
  aria-hidden="true"
  class="pointer-events-none absolute inset-0 -z-10 overflow-hidden"
>
  <div
    class="bg-brand/5 absolute top-32 -left-32 size-96 rounded-full blur-3xl"
  >
  </div>

  <div
    class="bg-brand/5 absolute -right-32 bottom-0 size-96 rounded-full blur-3xl"
  >
  </div>

  <pre
    class="text-ink/10 absolute top-44 left-1/3 hidden font-mono text-xs leading-6 font-semibold whitespace-pre md:block">{dataCode}</pre>

  <pre
    class="text-ink/10 absolute top-36 right-16 hidden font-mono text-xs leading-6 font-semibold whitespace-pre lg:block">{loopCode}</pre>

  <pre
    class="text-ink/10 absolute bottom-24 left-16 hidden font-mono text-xs leading-6 font-semibold whitespace-pre md:block">{conditionCode}</pre>

  <pre
    class="text-ink/10 absolute right-24 bottom-20 hidden font-mono text-xs leading-6 font-semibold whitespace-pre lg:block">{functionCode}</pre>

  <svg
    viewBox="0 0 100 32"
    fill="none"
    class="text-brand/40 absolute top-32 left-8 hidden h-8 w-24 lg:block"
  >
    <path
      d="M3 25C18 13 29 7 43 2"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"></path>

    <path
      d="M22 29C37 17 50 10 65 5"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"></path>
  </svg>

  <svg
    viewBox="0 0 100 32"
    fill="none"
    class="text-brand/40 absolute right-8 bottom-24 hidden h-8 w-24 lg:block"
  >
    <path
      d="M35 27C51 17 63 10 78 4"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"></path>

    <path
      d="M56 30C70 21 82 14 96 9"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"></path>
  </svg>
</div>
