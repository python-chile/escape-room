---
import { withBase } from "@/lib/paths";

const coverUrl = withBase("/brand/pyschool-cover.png");
---

<div class="relative">
  <div
    aria-hidden="true"
    class="bg-brand/10 absolute inset-0 m-auto size-64 rounded-full blur-3xl"
  >
  </div>

  <img
    src={coverUrl}
    alt="Logo de PySchool"
    class="relative h-44 w-auto max-w-full object-contain sm:h-52"
  />
</div>
