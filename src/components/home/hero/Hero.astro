---
import HeroContent from "./HeroContent.astro";
import HeroContributors from "./HeroContributors.astro";
import HeroIllustration from "./HeroIllustration.astro";
import HeroProjectActions from "./HeroProjectActions.astro";
---

<section
  aria-labelledby="hero-title"
  class="flex flex-1 items-center py-12 sm:py-16"
>
  <div class="mx-auto w-full max-w-7xl px-6 sm:px-10">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <HeroContent />
      <HeroIllustration />
    </div>

    <div class="mt-12 flex justify-center">
      <HeroContributors />
    </div>

    <div class="mt-8 flex justify-center">
      <HeroProjectActions />
    </div>
  </div>
</section>
