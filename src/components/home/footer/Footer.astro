---
import FooterBackdrop from "./FooterBackdrop.astro";
import FooterBrand from "./FooterBrand.astro";
import FooterCommunity from "./FooterCommunity.astro";
import FooterMascot from "./FooterMascot.astro";
---

<footer
  aria-label="Pie de página"
  class="bg-paper relative isolate overflow-hidden"
>
  <FooterBackdrop />

  <div
    class="relative mx-auto grid max-w-6xl gap-14 px-6 pt-24 pb-20 sm:px-10 sm:pt-28 lg:grid-cols-3 lg:gap-16 lg:pb-32"
  >
    <div class="lg:col-span-2">
      <FooterBrand />
    </div>

    <div class="relative z-20 lg:pt-20">
      <FooterCommunity />
    </div>

    <FooterMascot />
  </div>
</footer>
