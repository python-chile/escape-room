---
import PrimaryActionLink from "@/components/ui/PrimaryActionLink.astro";
---

<section aria-labelledby="footer-heading" class="relative z-20 max-w-2xl">
  <h2
    id="footer-heading"
    class="font-sketch text-ink mt-6 text-5xl leading-none font-bold tracking-tight sm:text-6xl lg:text-7xl"
  >
    <span class="block">SIGUE</span>
    <span class="text-brand block">APRENDIENDO.</span>
  </h2>

  <div class="mt-9">
    <PrimaryActionLink
      href="#estaciones"
      label="Explorar estaciones"
      fullWidth
    />
  </div>
</section>
