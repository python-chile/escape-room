---
import AccountStationCard from "./AccountStationCard.astro";
import { stationNavigations } from "@/data/stations/registry";

const stationGroups = Object.values(stationNavigations).map((navigation) => ({
  code: navigation.code,
  title: navigation.title,
  rooms: navigation.items.flatMap((item) =>
    item.href && item.label.startsWith("Habitación") ? [item.href] : [],
  ),
}));
---

<section class="mt-12">
  <div class="flex items-end justify-between gap-4">
    <div>
      <p class="text-brand font-mono text-xs font-bold tracking-widest">
        AVANCE GENERAL
      </p>

      <h2 class="mt-2 text-2xl font-bold tracking-tight">
        Desafíos completados
      </h2>
    </div>

    <p
      class="text-ink font-mono text-xl font-bold"
      aria-label="Desafíos completados"
      aria-live="polite"
    >
      <span data-account-total>0</span>
      <span class="text-muted">/</span>
      <span data-account-available>0</span>
    </p>
  </div>

  <div class="mt-5 grid gap-5">
    {
      stationGroups.map((station) => (
        <AccountStationCard
          code={station.code}
          title={station.title}
          rooms={station.rooms}
        />
      ))
    }
  </div>
</section>
