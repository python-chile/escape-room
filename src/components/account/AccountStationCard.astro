---
interface Props {
  code: string;
  title: string;
  rooms: string[];
}

const { code, title, rooms } = Astro.props;
---

<section
  class="border-ink/15 border bg-white p-5 shadow-sm"
  data-account-station
  data-room-paths={JSON.stringify(rooms)}
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-brand font-mono text-xs font-bold tracking-widest">
        {code}
      </p>

      <h3 class="mt-2 text-lg font-bold">{title}</h3>
    </div>

    <p
      class="text-ink font-mono text-sm font-bold"
      aria-label={`Progreso en ${title}`}
      aria-live="polite"
    >
      <span data-station-completed>0</span>
      <span class="text-muted">/</span>
      <span>{rooms.length}</span>
    </p>
  </div>

  <div class="bg-ink/10 mt-5 h-2 overflow-hidden" aria-hidden="true">
    <div
      class="bg-brand h-full transition-all duration-500"
      style="width: 0%"
      data-station-progress
    >
    </div>
  </div>
</section>
