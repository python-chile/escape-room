---
import { SEO } from "astro-seo";

import { withBase } from "@/lib/paths";

import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  image?: string;
  noindex?: boolean;
  nofollow?: boolean;
}

const {
  title,
  description,
  bodyClass = "text-ink",
  image = "/brand/pyschool-cover.png",
  noindex = false,
  nofollow = false,
} = Astro.props;

const siteName = "PySchool";

const fullTitle = title === siteName ? siteName : `${title} — ${siteName}`;

const canonicalUrl = new URL(
  Astro.url.pathname,
  Astro.site ?? Astro.url.origin,
).toString();

const imageUrl = new URL(
  withBase(image),
  Astro.site ?? Astro.url.origin,
).toString();

const faviconUrl = withBase("/favicon.png");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="generator" content={Astro.generator} />

    <SEO
      title={title}
      titleTemplate={title === siteName ? "%s" : `%s — ${siteName}`}
      description={description}
      canonical={canonicalUrl}
      noindex={noindex}
      nofollow={nofollow}
      robotsExtras="max-snippet:-1, max-image-preview:large, max-video-preview:-1"
      openGraph={{
        basic: {
          title: fullTitle,
          type: "website",
          image: imageUrl,
          url: canonicalUrl,
        },
        optional: {
          description,
          locale: "es_CL",
          siteName,
        },
        image: {
          secureUrl: imageUrl,
          type: "image/png",
          alt: "PySchool — Aprende Python resolviendo desafíos",
        },
      }}
      twitter={{
        card: "summary_large_image",
        title: fullTitle,
        description,
        image: imageUrl,
        imageAlt: "PySchool — Aprende Python resolviendo desafíos",
      }}
    />

    <link rel="icon" type="image/png" href={faviconUrl} />

    <meta name="theme-color" content="#f7f9fc" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cabin+Sketch:wght@400;700&family=IBM+Plex+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
    />

    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <slot />
  </body>
</html>
