---
import CodeBlocks from "@/components/station/content/CodeBlocks.astro";
import StationHeader from "@/components/station/navigation/Header.astro";
import StationSidebar from "@/components/station/navigation/Sidebar.astro";
import type { StationNavigation } from "@/data/stations/navigation";
import type { Station } from "@/data/stations/registry";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  currentPath: string;
  navigation: StationNavigation;
  station: Station;
  title: string;
  immersive?: boolean;
}

const {
  currentPath,
  navigation,
  station,
  title,
  immersive = false,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={`${title} — ${station.name} | PySchool`}
  bodyClass="text-ink"
>
  <div class="border-ink/10 bg-paper border-b">
    <div class="px-5 sm:px-10 lg:px-8 xl:px-12 2xl:px-16">
      <StationHeader stationId={station.id} />
    </div>
  </div>

  <div
    class="station-shell w-full lg:grid lg:px-8 xl:px-12 2xl:px-16"
    data-station-shell
  >
    <StationSidebar currentPath={currentPath} navigation={navigation} />

    <main
      id="main-content"
      class="min-w-0 px-5 py-10 sm:px-10 sm:py-14 lg:px-16 lg:py-16 xl:px-20 2xl:px-24"
    >
      <article
        class:list={["w-full", immersive ? "max-w-6xl" : "max-w-5xl"]}
        aria-labelledby="station-room-title"
      >
        {
          !immersive && (
            <>
              <p class="text-accent-dark mb-4 font-mono text-xs font-bold tracking-widest uppercase lg:hidden">
                {navigation.title}
              </p>

              <h1
                id="station-room-title"
                class="text-brand lg:text-ink text-4xl font-bold tracking-tight sm:text-5xl"
              >
                {title}
              </h1>
            </>
          )
        }

        <div class:list={["station-content", !immersive && "mt-10"]}>
          <slot />
        </div>
      </article>

      <CodeBlocks />
    </main>
  </div>
</BaseLayout>

<style>
  .station-shell {
    min-height: calc(100dvh - 5rem);
  }

  .station-content :global(h2) {
    margin-top: 3rem;
    color: var(--color-ink);
    font-size: 1.875rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .station-content :global(h3) {
    margin-top: 2.25rem;
    color: var(--color-ink);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .station-content :global(p),
  .station-content :global(li) {
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.75;
  }

  .station-content :global(p + p) {
    margin-top: 1.25rem;
  }

  .station-content :global(ul),
  .station-content :global(ol) {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-left: 1.25rem;
  }

  .station-content :global(ul) {
    list-style-type: disc;
  }

  .station-content :global(ol) {
    list-style-type: decimal;
  }

  .station-content :global(li::marker) {
    color: var(--color-brand);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .station-content :global(p a),
  .station-content :global(li a) {
    border-radius: 0.125rem;
    color: var(--color-brand);
    font-weight: 700;
    text-decoration-color: var(--color-accent);
    text-decoration-line: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    transition: color 150ms ease;
  }

  .station-content :global(p a:hover),
  .station-content :global(li a:hover) {
    color: var(--color-brand-dark);
  }

  .station-content :global(p a:focus-visible),
  .station-content :global(li a:focus-visible) {
    outline: 2px solid var(--color-brand);
    outline-offset: 0.25rem;
  }

  @media (min-width: 40rem) {
    .station-content :global(p),
    .station-content :global(li) {
      font-size: 1.0625rem;
      line-height: 1.8;
    }
  }

  @media (min-width: 64rem) {
    .station-shell {
      grid-template-columns: 20rem minmax(0, 1fr);
    }

    .station-content :global(h2) {
      font-size: 1.875rem;
    }
  }
</style>
