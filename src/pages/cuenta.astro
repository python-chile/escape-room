---
import AccountLogout from "@/components/account/AccountLogout.astro";
import AccountProfile from "@/components/account/AccountProfile.astro";
import AccountProgress from "@/components/account/AccountProgress.astro";
import HomeHeader from "@/components/home/HomeHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Mi cuenta"
  description="Tu progreso y cuenta de PySchool."
  bodyClass="bg-paper text-ink"
  robots="noindex, nofollow"
>
  <div class="min-h-dvh">
    <div class="mx-auto max-w-7xl px-6 sm:px-10">
      <HomeHeader />
    </div>

    <main class="mx-auto max-w-3xl px-6 py-14 sm:px-10 sm:py-20">
      <section class="mt-10" data-account>
        <h1
          class="font-sketch mt-3 text-5xl leading-none font-bold sm:text-6xl"
        >
          Tu progreso
        </h1>

        <AccountProfile />
        <AccountProgress />
        <AccountLogout />
      </section>
    </main>
  </div>

  <script>
    import { initializeAccountPages } from "@/components/account/initialize-account";

    initializeAccountPages();
  </script>
</BaseLayout>
