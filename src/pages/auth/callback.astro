---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Conectando cuenta"
  description="Conectando tu cuenta de GitHub con PySchool."
  bodyClass="grid min-h-dvh place-items-center bg-paper text-ink"
  noindex
  nofollow
>
  <main class="text-center">
    <p class="text-brand font-mono text-xs font-bold tracking-widest">
      PYSCHOOL
    </p>

    <h1 class="font-sketch mt-3 text-4xl font-bold">Conectando tu cuenta…</h1>

    <p class="text-muted mt-3">Estamos recuperando tu progreso.</p>
  </main>

  <script>
    import { withBase } from "@/lib/paths";
    import { supabase } from "@/lib/supabase";

    const code = new URLSearchParams(window.location.search).get("code");

    if (code) {
      const { error } = await supabase.auth.exchangeCodeForSession(code);

      if (error) {
        console.error("No fue posible iniciar sesión:", error.message);
      }
    }

    window.location.replace(withBase("/"));
  </script>
</BaseLayout>
