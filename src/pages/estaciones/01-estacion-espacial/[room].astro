---
import { getCollection, render, type CollectionEntry } from "astro:content";

import StationLayout from "@/layouts/StationLayout.astro";

type Props = {
  entry: CollectionEntry<"stations">;
};

export async function getStaticPaths() {
  const entries = await getCollection("stations", ({ id }) => {
    return id.startsWith("space-station/") && id !== "space-station/welcome";
  });

  return entries.map((entry) => ({
    params: {
      room: entry.id.replace("space-station/", ""),
    },
    props: {
      entry,
    },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const currentPath = `/estaciones/01-estacion-espacial/${entry.id.replace(
  "space-station/",
  "",
)}`;
---

<StationLayout
  currentPath={currentPath}
  station={entry.data.station}
  title={entry.data.title}
>
  <Content />
</StationLayout>
