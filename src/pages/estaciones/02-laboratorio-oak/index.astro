---
import { getEntry, render } from "astro:content";

import StationLayout from "@/layouts/StationLayout.astro";

const entry = await getEntry("stations", "lab-oak/welcome");

if (!entry) {
  throw new Error("No se encontró la bienvenida del Laboratorio Oak.");
}

const { Content } = await render(entry);
---

<StationLayout
  currentPath={Astro.url.pathname}
  station={entry.data.station}
  title={entry.data.title}
>
  <Content />
</StationLayout>
